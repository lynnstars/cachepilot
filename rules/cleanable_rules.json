{
  "schema_version": 1,
  "categories": {
    "package-manager": "包管理器缓存",
    "ai-tools": "AI 工具残留",
    "browser-automation": "浏览器自动化",
    "build-artifacts": "工程构建产物",
    "app-caches": "应用缓存(白名单)",
    "general": "通用清理"
  },
  "rules": [
    {
      "id": "npm-cacache",
      "category": "package-manager",
      "tool": "npm",
      "name": "npm 下载缓存 _cacache",
      "risk": "low",
      "paths": ["~/.npm/_cacache", "~/.npm/_logs"],
      "min_size_mb": 50,
      "why": "npm install 的全局包缓存，删除不影响已安装依赖，下次 install 重新命中/下载",
      "official_cmd": "npm cache clean --force",
      "default_clean": true
    },
    {
      "id": "pnpm-store",
      "category": "package-manager",
      "tool": "pnpm",
      "name": "pnpm 全局 store",
      "risk": "low",
      "paths": ["~/Library/Caches/pnpm", "~/.pnpm-store"],
      "min_size_mb": 100,
      "why": "pnpm 硬链接存储的包缓存；若项目还在用 pnpm 不建议清(会丢硬链接节省)，此处仅预览",
      "official_cmd": "pnpm store prune",
      "default_clean": false
    },
    {
      "id": "yarn-cache",
      "category": "package-manager",
      "tool": "yarn",
      "name": "Yarn 缓存",
      "risk": "low",
      "paths": ["~/Library/Caches/Yarn"],
      "min_size_mb": 50,
      "why": "Yarn 下载的包缓存，可重建",
      "official_cmd": "yarn cache clean",
      "default_clean": true
    },
    {
      "id": "pip-cache",
      "category": "package-manager",
      "tool": "pip",
      "name": "pip 缓存",
      "risk": "low",
      "paths": ["~/Library/Caches/pip"],
      "min_size_mb": 50,
      "why": "pip 下载的 wheel 缓存，删除后 pip install 重新下载",
      "official_cmd": "pip cache purge",
      "default_clean": true
    },
    {
      "id": "uv-cache",
      "category": "package-manager",
      "tool": "uv",
      "name": "uv 缓存",
      "risk": "low",
      "paths": ["~/.cache/uv"],
      "min_size_mb": 100,
      "why": "uv 的全局包缓存，删除后重建；不影响已建 venv",
      "official_cmd": "uv cache clean",
      "default_clean": true
    },
    {
      "id": "brew-cache",
      "category": "package-manager",
      "tool": "Homebrew",
      "name": "Homebrew 下载缓存",
      "risk": "low",
      "paths": ["~/Library/Caches/Homebrew"],
      "min_size_mb": 50,
      "why": "brew 下载的安装包缓存，删除后重装会重新下载",
      "official_cmd": "brew cleanup --prune=all",
      "default_clean": true
    },
    {
      "id": "brew-old-versions",
      "category": "package-manager",
      "tool": "Homebrew",
      "name": "Homebrew 旧版本(需先 dry-run)",
      "risk": "medium",
      "paths": [],
      "dynamic": "brew cleanup -n",
      "min_size_mb": 200,
      "why": "brew 卸载后遗留的旧版本/旧瓶；先用 dry-run 看可清多少",
      "official_cmd": "brew cleanup",
      "default_clean": false
    },
    {
      "id": "cargo-registry",
      "category": "package-manager",
      "tool": "cargo",
      "name": "cargo registry 缓存",
      "risk": "low",
      "paths": ["~/.cargo/registry"],
      "min_size_mb": 100,
      "why": "crates.io 下载缓存，删除后下次 build 重新拉取",
      "official_cmd": "cargo cache 或手动清 registry/cache",
      "default_clean": true
    },
    {
      "id": "go-mod-cache",
      "category": "package-manager",
      "tool": "go",
      "name": "go module 缓存",
      "risk": "low",
      "paths": ["~/go/pkg/mod/cache"],
      "min_size_mb": 100,
      "why": "go mod download 的模块缓存，删除后重新下载",
      "official_cmd": "go clean -modcache",
      "default_clean": true
    },
    {
      "id": "gradle-caches",
      "category": "package-manager",
      "tool": "gradle",
      "name": "gradle 构建缓存",
      "risk": "medium",
      "paths": ["~/.gradle/caches"],
      "min_size_mb": 200,
      "why": "gradle 依赖+构建缓存；清后下次构建变慢需重下依赖",
      "official_cmd": "手动删除 ~/.gradle/caches",
      "default_clean": false
    },
    {
      "id": "ollama-models",
      "category": "ai-tools",
      "tool": "ollama",
      "name": "ollama 模型(展示不删)",
      "risk": "high",
      "paths": ["~/.ollama/models/blobs"],
      "min_size_mb": 100,
      "why": "本地大模型文件，删了要重新下载；此条目仅展示占用，如需删请在 ollama 内 rm 或确认后单独处理",
      "official_cmd": "ollama list / ollama rm <model>",
      "default_clean": false,
      "show_only": true
    },
    {
      "id": "hf-cache",
      "category": "ai-tools",
      "tool": "HuggingFace",
      "name": "HF hub 下载缓存",
      "risk": "medium",
      "paths": ["~/.cache/huggingface/hub"],
      "min_size_mb": 200,
      "why": "从 HF 下载的模型/数据集缓存；删除后用到时重新下载",
      "official_cmd": "手动删除或 huggingface-cli",
      "default_clean": false
    },
    {
      "id": "comfyui-cache",
      "category": "ai-tools",
      "tool": "ComfyUI",
      "name": "ComfyUI 临时缓存",
      "risk": "medium",
      "paths": ["~/ComfyUI/temp", "~/ComfyUI/cache"],
      "min_size_mb": 100,
      "why": "ComfyUI 运行临时文件；output 目录是作品，绝不自动动",
      "official_cmd": "手动清理 temp",
      "default_clean": false
    },
    {
      "id": "insightface",
      "category": "ai-tools",
      "tool": "insightface",
      "name": "insightface 模型缓存",
      "risk": "low",
      "paths": ["~/.insightface"],
      "min_size_mb": 100,
      "why": "人脸识别模型自动下载缓存，可重建",
      "official_cmd": "手动删除 ~/.insightface",
      "default_clean": true
    },
    {
      "id": "playwright-browsers",
      "category": "browser-automation",
      "tool": "Playwright",
      "name": "Playwright 浏览器引擎",
      "risk": "low",
      "paths": ["~/Library/Caches/ms-playwright"],
      "min_size_mb": 100,
      "why": "自动化测试下载的浏览器，删除后 playwright install 重装",
      "official_cmd": "npx playwright uninstall",
      "default_clean": true
    },
    {
      "id": "camoufox",
      "category": "browser-automation",
      "tool": "camoufox",
      "name": "camoufox 浏览器",
      "risk": "low",
      "paths": ["~/Library/Caches/camoufox"],
      "min_size_mb": 100,
      "why": "反检测浏览器缓存，可重装",
      "official_cmd": "重装即可",
      "default_clean": true
    },
    {
      "id": "derived-data",
      "category": "build-artifacts",
      "tool": "Xcode",
      "name": "Xcode DerivedData",
      "risk": "low",
      "paths": ["~/Library/Developer/Xcode/DerivedData"],
      "min_size_mb": 200,
      "why": "Xcode 编译中间产物，删除后重新编译即可",
      "official_cmd": "xcodebuild clean / 手动删除",
      "default_clean": true
    },
    {
      "id": "jianying-cache",
      "category": "app-caches",
      "tool": "剪映专业版",
      "name": "剪映素材缓存",
      "risk": "low",
      "paths": ["~/Movies/JianyingPro/User Data/Cache"],
      "min_size_mb": 200,
      "why": "剪映预览/素材缓存；草稿在 Projects 目录不受影响",
      "official_cmd": "剪映设置内清理",
      "default_clean": true
    },
    {
      "id": "trash",
      "category": "general",
      "tool": "系统",
      "name": "废纸篓",
      "risk": "medium",
      "paths": ["~/.Trash"],
      "min_size_mb": 50,
      "why": "废纸篓内容已是你主动删除过的，清空可回收；注意不可恢复",
      "official_cmd": "清倒废纸篓",
      "default_clean": false
    }
  ]
}
